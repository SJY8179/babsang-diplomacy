# 복사해서 .env 로 쓰세요:  cp .env.example .env
# mock = Yumi 호출 없이 데모 데이터로 전체 흐름 실행 / rest = Hey Yumi REST 호출
YUMI_MODE=mock
YUMI_API_KEY=hmp_your_key_here
YUMI_BASE_URL=https://api.heyyumi.ai/api/v1
# 사장님께 가는 요청(자리 문의·예약) 처리 방식
#   simulate (기본) = Yumi로 보내지 않음. rest 모드여도 검색만 실제, 문의·예약은 가짜 결과
#   sandbox         = Yumi 샌드박스 헤더를 붙여 보냄 (운영진에게 알림 안 가는지 확인한 뒤에만)
#   live            = 실제 사장님 알림. YUMI_LIVE=1 도 같이 있어야 열림
YUMI_ACTIONS=simulate
YUMI_LIVE=0
# 실제 요청을 허용할 가게(쉼표 구분 placeId). 비우면 live일 때 전부 실제. 하이드미플리즈 을지로 = 1185547279
YUMI_LIVE_PLACES=
# 1 이면 샌드박스/목 결과를 데모 시나리오대로 고정 (1번 불가, 2번 가능, 첫 예약 거절 → 다음 확정)
DEMO_SCRIPT=1

# 선택: 단톡방 텍스트를 LLM으로 해석. 비우면 규칙 기반 파서만 사용.
# 셸에 ANTHROPIC_API_KEY 로 export 하지 마세요 (Claude Code 로그인이 바뀝니다).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# 선택: 참석자별 이동 시간. 비우면 직선거리 기반 추정으로 표시됩니다.
ODSAY_API_KEY=
# 선택: 주요 역 표에 없는 출발지(역·동네 이름)를 좌표로 바꿀 때
KAKAO_REST_KEY=
# 참석자 공유 링크에 쓰는 주소 (배포하면 그 주소로)
PUBLIC_BASE_URL=http://localhost:8000
